# Copy to .env to change the ports used by start.sh (env vars take precedence).
#BACKEND_PORT=8000
#FRONTEND_PORT=5173

# Optional Claude cloud chat: exported by start.sh so the backend picks it up
# (can also live in backend/.env).
#INBOX_ANTHROPIC_API_KEY=

# This key is the ONLY INBOX_* variable that works from this file. Backend
# settings (INBOX_MAILDIR, INBOX_WINDOW_DAYS, ...) go in backend/.env — see
# backend/.env.example.
