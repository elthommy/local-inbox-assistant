# Copy to backend/.env and adjust. All variables are optional; defaults shown.

# Root scanned recursively for .eml files: every mailbox folder under it is
# indexed. Point it at a single folder's cur/ dir to index only that folder.
#INBOX_MAILDIR=~/.thunderbird/xxxxxxxx.default-release

# Folder names skipped during the scan (comma-separated, case-insensitive;
# also skips their subfolders). "All Mail" is Gmail's duplicate label archive.
#INBOX_EXCLUDE_FOLDERS=Trash,Junk,Spam,Drafts,Unsent Messages,All Mail

# Indexing window (days of mail kept in the index)
#INBOX_WINDOW_DAYS=90

# LLM task/event/priority extraction only runs on mail newer than this
#INBOX_EXTRACTION_WINDOW_DAYS=14
#INBOX_EXTRACTION_MAX_EMAILS=300

# Ollama. Chat and email parsing (task/event/priority extraction) can run
# different models; see "Changing models" in the README.
#INBOX_OLLAMA_URL=http://localhost:11434
#INBOX_CHAT_MODEL=qwen3:8b
#INBOX_EXTRACTION_MODEL=qwen3:8b
#INBOX_EMBED_MODEL=nomic-embed-text

# Claude cloud (step 2 — not implemented yet, key is read but unused)
#INBOX_ANTHROPIC_API_KEY=
